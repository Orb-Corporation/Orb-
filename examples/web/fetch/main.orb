// Fetch and JSON: asynchronous HTTP, parsing the response, building DOM from it.
use web;
use json;
use http;

people: web.Element;

fn show_status(text: str) {
    web.set_text_by_id("status", text) catch |e| {};
}

fn render(j: web.Json) -> ! {
    n := try json.len(j);
    for i in 0..n {
        p := try json.at(j, i);
        nj := try json.get(p, "name");
        rj := try json.get(p, "role");
        name := try json.as_string(nj);
        role := try json.as_string(rj);
        li := try web.create("li");
        try web.set_text(li, name);
        sep := try web.create_text(" - ");
        em := try web.create("em");
        try web.set_text(em, role);
        try web.append(li, sep);
        try web.append(li, em);
        try web.append(people, li);
        web.free_str(name);
        web.free_str(role);
        web.release(sep);
        web.release(em);
        web.release(li);
        json.release(nj);
        json.release(rj);
        json.release(p);
    }
    return;
}

fn on_response(r: web.Response) {
    if http.failed(r) {
        show_status("Network error: the request could not be sent.");
        return;
    }
    if !http.ok(r) {
        show_status("The server answered with an error status.");
        return;
    }
    body := http.body_text(r) catch |e| { show_status("Could not read the response."); return; };
    j := json.parse(body) catch |e| { http.free_text(body); show_status("The response is not valid JSON."); return; };
    http.free_text(body);
    web.clear(people) catch |e| {};
    render(j) catch |e| { show_status("Unexpected JSON shape."); json.release(j); return; };
    json.release(j);
    show_status("Loaded.");
}

fn on_load() {
    show_status("Loading...");
    http.get("people.json", on_response) catch |e| { show_status("Could not start the request."); };
}

fn main() {
    people = web.get_element("people") catch |e| { return; };
    b := web.get_element("load") catch |e| { return; };
    web.on_click(b, on_load) catch |e| { return; };
}
