use json;

fn main() {
    good := "{\"title\":\"Orb!\",\"data\":[1,-2,3.25e+2,true,false,null,{\"ok\":\"yes\"}]}";
    println(json.validate(good));
    println(json.validate("{\"x\":01}"));
    println(json.validate("[1,2,]"));
    println(json.validate("\"escaped \\\\n and \\\\u0041\""));
    println(json.validate("true false"));
    encoded := json.quote("a\"b\n");
    println(json.validate(encoded));
    println(encoded == "\"a\\\"b\\n\"");
}
